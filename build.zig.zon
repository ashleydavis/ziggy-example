.{
    .name = .ziggy_test_app,
    .version = "1.0.0",
    .fingerprint = 0x37269507ca0f0698,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Ziggy, from a checkout of it beside this app. An app can point at a version
        // tag of Ziggy's repository by URL and hash instead (see the guide to integrating Ziggy).
        .ziggy = .{
            .path = "../ziggy",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "core",
        "shells",
    },
}
